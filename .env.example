# Configuration pour CV Generator AI

# Modèle Ollama à utiliser (optionnel - défaut: qwen2.5:7b)
# Autres options: llama3.1:8b, mistral:7b, etc.
OLLAMA_MODEL=qwen2.5:7b

# Note: Ce projet utilise Ollama, une IA locale 100% gratuite
#
# Installation d'Ollama:
# - macOS/Linux: curl -fsSL https://ollama.com/install.sh | sh
# - Windows: Téléchargez depuis https://ollama.com/download
#
# Lancer Ollama:
#   ollama serve
#
# Télécharger le modèle recommandé:
#   ollama pull qwen2.5:7b
